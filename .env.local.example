# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio API key for Gemma
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Path to a Python executable with `manim` installed (pip install manim),
# used by app/api/topics/[topicId]/video to render chat answers as videos.
# Only needs setting if your default `python` on PATH isn't the one you
# installed manim into.
MANIM_PYTHON=python
